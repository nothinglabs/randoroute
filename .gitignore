# Raw source data (fetched at build time, not committed)
data/BikePedLTS.zip
data/BikePedLTS.gdb/
data/BikePedLevelOfTrafficStress_FGDC.*
data/washington-latest.osm.pbf
data/census-urban-areas-2020-*.geojson
data/*.osm.pbf
node_modules/
.venv/
*.tgz
# Generated lightweight Capacitor web bundle. Rebuilt by `npm run ios:sync`.
# Keep index.html as a tracked, immediately buildable copy; supporting assets
# are regenerated and ignored.
mobile-shell/*
!mobile-shell/README.md
!mobile-shell/index.html
data/PermanentBikeRestrictions.zip
data/PermBikeRestrictions.zip
data/permbike/
data/wsdot_bike_facilities.geojson
data/wsdot_legal_speeds.geojson
# The same two files for any other state's agency fetcher (scripts/build_odot.py).
data/odot_bike_facilities.geojson
data/odot_legal_speeds.geojson
# local test scaffolding
_*.mjs
_*.html
data/dem/
# Elevation tiles are a build input, fetched per state and never shipped.
maps/*/dem
# Natural Earth land polygon: a shared build input (scripts/fetch_natural_earth.sh).
data/natural-earth/
# tippecanoe intermediates (rebuilt from the PBF; output is roads.pmtiles)
# The roads builder shards its output as <out-prefix>-N.geojson, and the
# prefix carries the state on every state but the default -- so a rule
# naming only `roads-` leaked data/oregon-roads-*.geojson into git status.
data/*roads-*.geojson
data/*.pmtiles-journal
maps/*/*.pmtiles-journal
__pycache__/
# Statewide road measurements: large build-time inputs, conflated into the
# graph and tiles rather than shipped. Rebuild with scripts/build_roadlog.py,
# build_funcclass.py, build_aadt.py and build_hpms.py.
data/roadlog.geojson
data/funcclass.geojson
data/aadt.geojson
data/hpms.geojson
# ...and their per-state names, once more than one state builds them.
data/roadlog-*.geojson
data/funcclass-*.geojson
data/aadt-*.geojson
data/hpms-*.geojson
data/.cache/
# Scratch: build logs and the verification harness's dumps. Rebuildable, and
# the route dumps are ~12 MB each because they carry every option's geometry.
data/_*
